# Variables del bot. Defínelas en el servidor del bot (Railway, Fly.io, VPS),
# NUNCA en el repositorio ni en Vercel.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
LOGIKS_URL=https://logiksco.vercel.app
# El mismo valor que FE_WORKER_SECRET en Vercel (firma los avisos).
FE_WORKER_SECRET=
WORKER_ID=bot-1
# Mientras no sea "si", todo se ejecuta en modo prueba (se detiene antes de «Enviar»).
FE_PERMITIR_EMISION=no
HEADLESS=si
