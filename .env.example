# Sin las variables de Supabase la app arranca en MODO DEMO (datos en memoria, sin login).

# Supabase · Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: enlace público, portal del cliente, invitaciones, webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (enlaces en correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correo (opcional). Sin llave no se envía nada, pero todo queda en la trazabilidad.
RESEND_API_KEY=
CORREO_REMITENTE=notificaciones@tu-dominio.co
# Webhook de Resend (entregado/abierto) → /api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# Megafoco (opcional). La llave de API de cada empresa se guarda cifrada en
# Configuración; aquí solo va la URL base de la API y el secreto del webhook.
MEGAFOCO_API_URL=
MEGAFOCO_WEBHOOK_SECRET=
