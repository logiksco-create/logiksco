# Sin las variables de Supabase la app arranca en MODO DEMO (datos en memoria, sin login).

# Supabase · Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: enlace público, portal del cliente, invitaciones, webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (enlaces en correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correo (opcional). Sin llave no se envía nada, pero todo queda en la trazabilidad.
RESEND_API_KEY=
CORREO_REMITENTE=notificaciones@tu-dominio.co
# Webhook de Resend (entregado/abierto) → /api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# Megafoco (opcional). La llave de API de cada empresa se guarda cifrada en
# Configuración; aquí solo va la URL base de la API y el secreto del webhook.
MEGAFOCO_API_URL=
MEGAFOCO_WEBHOOK_SECRET=

# Facturación electrónica: secreto compartido con el bot (worker/einvoice-bot)
# para firmar los avisos a /api/fe/notificar. El bot corre fuera de Vercel.
FE_WORKER_SECRET=

# Bot bajo demanda en GitHub Actions (.github/workflows/bot-finppi.yml):
# token de grano fino con «Actions: Read and write» SOLO sobre el repositorio.
GITHUB_BOT_TOKEN=
# GITHUB_BOT_REPO=logiksco-create/logiksco

# Tarea diaria (Vercel Cron, ver vercel.json): alertas, resumen por rol y
# recordatorios de la 170. Vercel envía "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Buzón por DO (correo entrante): dominio que recibe do-xxxx@<dominio> y
# secreto HMAC con el que el proveedor de correo entrante firma el JSON.
CORREO_ENTRANTE_DOMINIO=entrante.logiks.co
CORREO_ENTRANTE_SECRET=

# TRM de respaldo si datos.gov.co no responde.
TRM_RESPALDO=4000
